@* Layout base ESPECIAL para Planilla Semanal *@
@using System

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>@ViewBag?.Title</title>

  <!-- Fuerza esquema de color claro -->
  <meta name="color-scheme" content="light" />

  <style>
    :root { color-scheme: light; }

    html {
      height: 100%;
      overflow-y: scroll;
      scrollbar-gutter: stable both-edges;
      background: #ffffff;
    }

    body {
      margin: 0;
      font-family: system-ui, Segoe UI, Arial;
      background: #ffffff;
      color: #111;
    }

    /* ======== IMPRESIÓN: LETTER LANDSCAPE + ESCALA ======== */
    @@page {
      size: Letter landscape;        /* Apaisado */
      margin: 10mm;
    }

    @@media print {
      html, body { -webkit-print-color-adjust: exact; }

      .page-wrapper {
        /* Escala ligera para que quepa TODA la tabla en ancho */
        transform: scale(0.92);
        transform-origin: top left;
        /* Como escalamos, aumentamos un poco el ancho lógico
           para que no aparezca barra de scroll rara */
        width: 108%;
      }

      .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
      }

      .footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        font-size: 10px;
        color: #555;
      }

      .content {
        margin-top: 95px;
        margin-bottom: 40px;
      }

      .no-break { break-inside: avoid; }
    }

    h1, h2, h3 { margin: 0; }

    /* ========= TABLA AJUSTADA A ANCHO ========= */
    table {
      width: 100%;
      border-collapse: collapse;
      background: #ffffff;
      table-layout: fixed;          /* reparte ancho entre columnas */
    }

    th, td {
      border: 1px solid #ddd;
      padding: 4px;                 /* menos padding para ganar ancho */
      font-size: 11px;              /* más pequeño que el layout general */
      background: #ffffff;
      color: #111;
      white-space: nowrap;          /* evita saltos raros */
      overflow: hidden;
      text-overflow: ellipsis;      /* corta texto largo pero mantiene columna */
    }

    th.col-carne,
td.col-carne {
  width: 8%;               /* suficiente para el número completo */
  white-space: nowrap;     /* no hace salto de línea */
  overflow: visible;       /* no recorta el contenido */
  text-overflow: clip;     /* sin puntos suspensivos */
}

th.col-cedula,
td.col-cedula {
  width: 8%;              /* un poco más ancha que Carne */
  white-space: nowrap;
  overflow: visible;
  text-overflow: clip;
}

        th.col-empleado,
    td.col-empleado {
      width: 22%;
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }

    th {
      background: #f1f5f9;
      text-align: left;
      font-weight: 600;
    }

    td.num { text-align: right; }

    tr:nth-child(even) td { background: #fafafa; }

    /* Cabecera corporativa con logo + info centrada */
    .hdr {
      display: grid;
      grid-template-columns: 160px 1fr 120px;
      align-items: center;
      gap: 8px;
      padding: 8px 6px 4px 6px;
      border-bottom: 3px solid #eab308;
      background: #ffffff;
    }

    .hdr .logo-wrap {
      grid-column: 1;
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    .hdr .logo-wrap img {
      height: 30px;
      object-fit: contain;
    }

    .hdr .info {
      grid-column: 2;
      text-align: center;
      line-height: 1.3;
      color: #111;
    }

    .hdr .info .company { font-weight: 600; font-size: 13px; }
    .hdr .info .phones,
    .hdr .info .address { font-size: 11px; }

    .hdr .spacer { grid-column: 3; }

    .title {
      font-size: 16px;
      font-weight: 600;
      margin: 10px 6px;
      color: #111;
    }

    .header {
      background: #ffffff;
    }

    .content {
      margin-top: 90px;
      margin-bottom: 40px;
      padding: 0 4px 80px 4px;
      background: #ffffff;
    }

    .footer { padding: 0 6px; }

    /* Neutraliza dark-mode */
    @@media (prefers-color-scheme: dark) {
      html, body, .hdr, .content, table, th, td {
        background: #ffffff !important;
        color: #111 !important;
      }
      th { background: #f1f5f9 !important; }
      tr:nth-child(even) td { background: #fafafa !important; }
    }
  </style>
</head>
<body>
  <div class="page-wrapper">
    <!-- Cabecera corporativa -->
    <div class="header">
      <div class="hdr">
        <div class="logo-wrap">
          <img src="https://@ViewBag.VirtualHost/@ViewBag.LogoFile"
               alt="logo" onerror="this.style.display='none'" />
        </div>
        <div class="info">
          <div class="company">@ViewBag.Company</div>
          <div class="phones">Telefonos: @ViewBag.Phones</div>
          <div class="address">Direccion: @ViewBag.Address</div>
        </div>
        <div class="spacer"></div>
      </div>

      <div class="title">@ViewBag.Title</div>
    </div>

    <div class="footer">
      @ViewBag?.Footer
    </div>

    <div class="content">
      @RenderBody()
    </div>
  </div>
</body>
</html>
