<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RootNamespace>Manga_Rica_P1</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Nueva implementacion: requerido por RazorLight para compilar .cshtml en runtime -->
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
		<GenerateRuntimeConfigDevFile>true</GenerateRuntimeConfigDevFile>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<AssemblyName>MangaRica Software</AssemblyName>
		<ApplicationIcon>Imagenes\Recursos\users_theuser_6177.ico</ApplicationIcon>
		<PackageId>MangaRica_Software</PackageId>
		<Title>MangaRica_Software</Title>
		<Authors>jertroll</Authors>
		<Description>Sistema de planilla para la administracion y pagos de los empleados</Description>
	</PropertyGroup>

